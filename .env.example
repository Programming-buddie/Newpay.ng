# GEMINI_API_KEY: Optional server-side API key injected at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NewPay Service Mode:
# Firebase Auth and Firestore are enabled by default.
# Set VITE_USE_MOCK_API="true" only to fall back to the local in-browser mock storage.
VITE_USE_MOCK_API="false"
VITE_API_BASE_URL="http://localhost:8080/api/v1"

# Server-side Admin Portal Credentials (optional; if unset, first-run claim flow activates)
ADMIN_USERNAME=
ADMIN_PASSWORD=

